{
  "expectation_suite_name": "dim_products_quality_suite",
  "data_asset_type": "Dataset",
  "meta": {
    "great_expectations_version": "0.18.12",
    "dataset_name": "dim_products",
    "target_columns": 10,
    "description": "Automated Great Expectations suite for dim_products"
  },
  "expectations": [
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "product_id"
      },
      "meta": {
        "dimension": "completeness",
        "severity": "CRITICAL",
        "description": "Product ID must not be null"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "product_id"
      },
      "meta": {
        "dimension": "consistency",
        "severity": "CRITICAL",
        "description": "Product ID must be unique primary key"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "product_name"
      },
      "meta": {
        "dimension": "completeness",
        "severity": "HIGH",
        "description": "Product name cannot be null"
      }
    },
    {
      "expectation_type": "expect_column_pair_values_a_to_be_greater_than_b",
      "kwargs": {
        "column_a": "unit_price",
        "column_b": "unit_cost",
        "or_equal": true
      },
      "meta": {
        "dimension": "accuracy",
        "severity": "HIGH",
        "issue_id": "ISSUE-17",
        "impacted_team": "Financial & Revenue Analytics",
        "description": "Product unit_price must exceed unit_cost (positive gross margin)"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "unit_price",
        "min_value": 0.01,
        "max_value": 5000.0
      },
      "meta": {
        "dimension": "accuracy",
        "severity": "MEDIUM",
        "description": "Unit price must be positive and within reasonable catalog limits"
      }
    },
    {
      "expectation_type": "expect_column_quantile_values_to_be_between",
      "kwargs": {
        "column": "weight_kg",
        "min_value": 0.01,
        "max_value": 50.0
      },
      "meta": {
        "dimension": "distribution",
        "severity": "HIGH",
        "issue_id": "ISSUE-22",
        "impacted_team": "Supply Chain & Operations Analytics",
        "description": "Product weight must not contain extreme anomalies (> 50kg for retail)"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "category",
        "value_set": [
          "Electronics",
          "Home & Kitchen",
          "Apparel",
          "Books",
          "Sports"
        ]
      },
      "meta": {
        "dimension": "accuracy",
        "severity": "MEDIUM",
        "description": "Category must conform to official merchandising taxonomy"
      }
    }
  ]
}