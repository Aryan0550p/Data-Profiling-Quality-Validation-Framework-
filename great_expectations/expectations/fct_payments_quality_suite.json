{
  "expectation_suite_name": "fct_payments_quality_suite",
  "data_asset_type": "Dataset",
  "meta": {
    "great_expectations_version": "0.18.12",
    "dataset_name": "fct_payments",
    "target_columns": 9,
    "description": "Automated Great Expectations suite for fct_payments"
  },
  "expectations": [
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "payment_id"
      },
      "meta": {
        "dimension": "completeness",
        "severity": "CRITICAL",
        "description": "Payment ID must not be null"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "payment_id"
      },
      "meta": {
        "dimension": "consistency",
        "severity": "CRITICAL",
        "description": "Payment ID must be unique primary key"
      }
    },
    {
      "expectation_type": "expect_conditional_column_values_to_not_be_null",
      "kwargs": {
        "column": "gateway_transaction_id",
        "condition_column": "payment_status",
        "condition_values": [
          "Success"
        ]
      },
      "meta": {
        "dimension": "completeness",
        "severity": "CRITICAL",
        "issue_id": "ISSUE-06",
        "impacted_team": "Financial & Revenue Analytics",
        "description": "Settled payments with status 'Success' must have gateway transaction ID"
      }
    },
    {
      "expectation_type": "expect_payment_amount_to_match_order_total",
      "kwargs": {
        "payment_amount_col": "amount_paid",
        "order_dataset": "fct_orders",
        "order_total_col": "total_amount"
      },
      "meta": {
        "dimension": "consistency",
        "severity": "CRITICAL",
        "issue_id": "ISSUE-11",
        "impacted_team": "Financial & Revenue Analytics",
        "description": "Settled payment amount must reconcile identically with order total"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "payment_status",
        "value_set": [
          "Success",
          "Pending",
          "Failed",
          "Refunded"
        ]
      },
      "meta": {
        "dimension": "accuracy",
        "severity": "HIGH",
        "description": "Payment status must match allowed gateway statuses"
      }
    }
  ]
}